# Variables d'environnement de LexWatch
#
# Toutes les variables ci-dessous sont OPTIONNELLES : le site fonctionne
# intégralement sans elles. Chaque intégration reste simplement inactive
# tant que sa variable n'est pas définie (voir lib/analytics-config.ts et
# lib/site-config.ts). Aucune variable de ce fichier n'est un secret —
# toutes sont préfixées NEXT_PUBLIC_ et donc visibles côté client par
# construction (identifiants analytics et jetons de vérification
# webmaster, publics par nature). Ne jamais ajouter ici une clé privée,
# un mot de passe ou une chaîne de connexion.
#
# Pour utiliser ce fichier : copier vers .env.local puis renseigner les
# valeurs utiles.
#   cp .env.example .env.local

# --- Analytics (composants/analytics/analytics-scripts.tsx) -----------------

# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX).
# Laisser vide pour ne charger aucun script Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Identifiant de projet Microsoft Clarity.
# Laisser vide pour ne charger aucun script Clarity.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Domaine enregistré sur Plausible Analytics (ex. lexwatch.io).
# Laisser vide pour ne charger aucun script Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Vérification des outils webmaster (lib/site-config.ts) -----------------

# Jeton de vérification Google Search Console (balise
# <meta name="google-site-verification">). Disponible dans Search Console,
# section Paramètres de la propriété > Vérification de la propriété.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Jeton de vérification Bing Webmaster Tools (balise
# <meta name="msvalidate.01">).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
