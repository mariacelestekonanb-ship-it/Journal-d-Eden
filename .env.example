# Variables d'environnement de LexWatch
#
# Toutes les variables ci-dessous sont OPTIONNELLES sauf ADMIN_PASSWORD
# (voir plus bas) : le reste du site fonctionne intégralement sans elles.
# Chaque intégration reste simplement inactive tant que sa variable n'est
# pas définie (voir lib/analytics-config.ts et lib/site-config.ts). Ces
# variables analytics/webmaster ne sont pas des secrets — elles sont
# préfixées NEXT_PUBLIC_ et donc visibles côté client par construction.
#
# Pour utiliser ce fichier : copier vers .env.local puis renseigner les
# valeurs utiles.
#   cp .env.example .env.local

# --- Authentification de l'espace d'administration (lib/admin/session.ts) ---

# Mot de passe unique protégeant tout /admin (voir middleware.ts). À la
# différence des variables ci-dessous, c'est un VRAI secret : ne jamais le
# préfixer NEXT_PUBLIC_, ne jamais le committer dans .env.local. Sans cette
# variable définie, personne ne peut se connecter à /admin — y compris
# vous (échec volontaire par défaut, plutôt qu'un admin laissé ouvert). À
# renseigner en local dans .env.local, et dans les variables
# d'environnement du projet sur Vercel pour la production.
ADMIN_PASSWORD=

# --- Analytics (composants/analytics/analytics-scripts.tsx) -----------------

# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX).
# Laisser vide pour ne charger aucun script Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Identifiant de projet Microsoft Clarity.
# Laisser vide pour ne charger aucun script Clarity.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Domaine enregistré sur Plausible Analytics (ex. lexwatch.io).
# Laisser vide pour ne charger aucun script Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Vérification des outils webmaster (lib/site-config.ts) -----------------

# Jeton de vérification Google Search Console (balise
# <meta name="google-site-verification">). Disponible dans Search Console,
# section Paramètres de la propriété > Vérification de la propriété.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Jeton de vérification Bing Webmaster Tools (balise
# <meta name="msvalidate.01">).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
