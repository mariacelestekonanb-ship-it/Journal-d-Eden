# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service — usage serveur uniquement (administration des comptes). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (utilisée pour les liens dans les emails/notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifications push (voir NOTIFICATIONS.md#push) — clés VAPID, propres à ce projet.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact transmise aux services de push (RFC 8292) — pas d'e-mail réellement envoyé.
PUSH_VAPID_SUBJECT=mailto:notifications@example.com
# Secret partagé avec le Database Webhook Supabase qui appelle /api/push/send.
PUSH_WEBHOOK_SECRET=
